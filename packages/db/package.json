{
  "name": "@natija/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./seed": "./src/seed/index.ts",
    "./seed/data": "./src/seed/data.ts"
  },
  "scripts": {
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed/index.ts",
    "reset": "tsx src/reset.ts",
    "generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@natija/domain": "workspace:*",
    "@natija/protocols": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.11"
  }
}
