{
  "name": "natija",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Natija: a multi-tenant laboratory information system for medical labs",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "pnpm --filter @natija/web run dev",
    "dev:full": "node scripts/dev.mjs",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "db:status": "node scripts/db.mjs status",
    "db:migrate": "pnpm --filter @natija/db run migrate",
    "db:seed": "pnpm --filter @natija/db run seed",
    "db:reset": "pnpm --filter @natija/db run reset",
    "seed:demo": "pnpm --filter @natija/db run reset && pnpm --filter @natija/api run seed:history",
    "api": "pnpm --filter @natija/api run dev",
    "web": "pnpm --filter @natija/web run dev",
    "agent": "pnpm --filter @natija/agent run start",
    "simulate": "pnpm --filter @natija/simulator run start",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm --filter @natija/web run build",
    "build:offline": "pnpm --filter @natija/web run build:offline",
    "start": "node scripts/start.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "embedded-postgres": "18.6.0-beta.19",
    "pg": "^8.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
