# Copy to .env (never commit .env). Defaults work for local development.

# Owner connection: migrations and seeding only.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/natija
# Application connection: role natija_app, always under row-level security.
APP_DATABASE_URL=postgres://natija_app:natija_app_dev@localhost:5433/natija
# Password given to natija_app when the local database is created.
APP_DB_PASSWORD=natija_app_dev

# Required in production: long random string (signs CSRF tokens). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

HOST=127.0.0.1
PORT=4310
# Address patients use to open report links and the QR verification page.
PUBLIC_URL=http://localhost:5173
# Set to true when running behind a reverse proxy (Caddy, nginx).
TRUST_PROXY=false

# Demo mode: shows demo accounts on the sign-in page and labels simulated messages.
DEMO_MODE=true
DEMO_PASSWORD=Natija@2026

SESSION_HOURS=12
SESSION_IDLE_MINUTES=120
LOGIN_RATE_LIMIT=10
STORAGE_DIR=./storage
LOG_LEVEL=info
